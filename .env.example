# Optional: connect your own Firebase project to enable online scores and admin.
# Copy to .env.local and fill in all five values from your Firebase web app.
# Leave blank to play locally without publishing scores.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=
