  "cards": [
    {
      "dot": "cyan",
      "title": "01 · Play locally",
      "items": [
        "Five practice swings → countdown → 15-second round. Alternating wrist heights drive score and rank.",
        "Frames and certificate snapshots stay in browser memory; PNG and PDF exports download locally."
      ]
    },
    {
      "dot": "amber",
      "title": "02 · Cross a boundary",
      "items": [
        "Google and jsDelivr supply model/WASM assets; Google Fonts supplies typography. Inference runs on-device.",
        "Optional Firebase receives nickname, score, timestamp and consent choice. It never receives the camera snapshot."
      ]
    },
    {
      "dot": "emerald",
      "title": "03 · Share a score",
      "items": [
        "Realtime Database supplies the public daily top five. Without Firebase, play and certificate export still work.",
        "Rules validate score writes. Admin edits require Firebase Auth plus an admin claim; scores remain client-calculated."
      ]
    }
  ]
